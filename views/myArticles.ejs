<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | BlogSpace</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <div class="page-header">
      <h1>My Articles</h1>
      <p>Articles written by you</p>
    </div>

    <div style="text-align: right; margin-bottom: 1.5rem;">
      <a href="/articles/new" class="btn btn-primary">+ New Article</a>
    </div>

    <% if (articles && articles.length > 0) { %>
      <% articles.forEach(article => { %>
        <article class="article-card">
          <h2><a href="/articles/<%= article._id %>"><%= article.title %></a></h2>
          <div class="meta">
            <span>📅 <%= new Date(article.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            <span>💬 <%= article.comments ? article.comments.length : 0 %> comments</span>
          </div>
          <p class="article-excerpt"><%= article.content.substring(0, 200) %><%= article.content.length > 200 ? '...' : '' %></p>
          <div class="card-actions">
            <a href="/articles/<%= article._id %>" class="btn btn-primary btn-sm">View</a>
            <a href="/articles/<%= article._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
            <form action="/articles/<%= article._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Delete this article?');">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <h3>You haven't written any articles yet</h3>
        <p>Share your first story with the world!</p>
        <a href="/articles/new" class="btn btn-primary" style="margin-top: 1rem;">Write Your First Article</a>
      </div>
    <% } %>
  </div>

  <footer>
    <p>BlogSpace &copy; <%= new Date().getFullYear() %></p>
  </footer>
</body>
</html>
